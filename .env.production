# Environment variables for production deployment

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (Use MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/car-store
DB_NAME=car-store

# JWT Configuration
JWT_SECRET=generate_a_very_long_random_string_minimum_32_characters_here
JWT_EXPIRE=7d

# Stripe Payment Gateway (Get from Stripe Dashboard)
STRIPE_PUBLIC_KEY=pk_live_your_live_public_key_here
STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here

# Cloudinary Image Upload (Optional)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=noreply@carstore.com

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Logging
LOG_LEVEL=error

# Security
CORS_ORIGIN=https://your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Admin Credentials (Initial setup only)
ADMIN_EMAIL=admin@carstore.com
ADMIN_PASSWORD=Change_This_Strong_Password_123

# Session Configuration
SESSION_SECRET=generate_another_random_string_here
SESSION_TIMEOUT=3600

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payment Settings
MIN_ORDER_AMOUNT=10
MAX_ORDER_AMOUNT=50000
SHIPPING_THRESHOLD=100
SHIPPING_COST=15
TAX_RATE=0.1
